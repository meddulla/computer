{
  // Example: Worker + Durable Object whose Workspace runs shell commands
  // on a Kitebuild machine, a BusyBox Linux userland in the same Durable
  // Object, working on the Workspace's files directly.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computer-kitebuild-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-26",
  // new_module_registry lets rg and jq load their wasm on first use.
  "compatibility_flags": ["nodejs_compat", "new_module_registry"],

  // BusyBox, its initramfs, rg and jq ship as precompiled wasm modules.
  // Every file under src/skills is uploaded as its own module, under its
  // path relative to src/, so WorkerBundle("skills") can copy it into the
  // workspace. "Data" keeps the bytes exactly as they are on disk.
  "find_additional_modules": true,
  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": false },
    { "type": "Data", "globs": ["skills/**/*"], "fallthrough": true }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "KitebuildExample",
        "class_name": "KitebuildExample"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KitebuildExample"]
    }
  ]
}
