{
  // Example: a Vite-built Worker whose Workspace runs shell commands,
  // JavaScript modules and Kitebuild's toolchain on a Kitebuild machine,
  // with a pi agent on top. vite.config.ts builds it; BusyBox, its
  // initramfs and the tools' wasm reach the Worker as wasm imports.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "computer-kitebuild-agent-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // new_module_registry lets the tools load their wasm on first use.
  "compatibility_flags": ["nodejs_compat", "new_module_registry"],

  // The page in index.html and ui/, built by Vite. Requests that match
  // no file, such as /c/<name>/..., go to the Worker.
  "assets": { "not_found_handling": "none" },

  // Workers AI. Running the agent uses your account's Workers AI quota.
  "ai": { "binding": "AI" },

  // The toolchain runs package code in Worker Loader isolates.
  "worker_loaders": [{ "binding": "LOADER" }],

  // The package cache keeps downloaded npm tarballs in the Cache API.
  "exports": {
    "PackageCacheOrigin": { "type": "worker", "cache": { "enabled": true } }
  },

  "durable_objects": {
    "bindings": [{ "name": "Agent", "class_name": "Agent" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Agent"] }]
}
